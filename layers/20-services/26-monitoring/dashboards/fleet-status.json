{
  "title": "Fleet Status (start here)",
  "uid": "fleet-status",
  "tags": ["overview", "fleet"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "title": "Services Up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(probe_success)", "legendFormat": "up", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "count(probe_success)", "legendFormat": "total", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "title": "Services Down",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "expr": "count(probe_success == 0) or vector(0)", "legendFormat": "down", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } }
    },
    {
      "title": "Nodes Reporting",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        { "expr": "count(up{job=~\"node|node-fleet\"} == 1)", "legendFormat": "of 3", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 2 }, { "color": "green", "value": 3 } ] } } }
    },
    {
      "title": "Firing Alerts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        { "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "legendFormat": "alerts", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } }
    },
    {
      "title": "Eval Pass Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "expr": "jarvis_eval_tests_passed / jarvis_eval_tests_total", "legendFormat": "pass rate", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "title": "Last Eval Run",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "expr": "time() - jarvis_eval_last_run_timestamp_seconds", "legendFormat": "age", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Service Matrix (1 = up)",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "probe_success", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "transformations": [
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
          "renameByName": { "service": "Service", "machine": "Host", "tier": "Tier", "Value": "Up" }
        } }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "title": "Node CPU / Memory / Disk (%)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100", "legendFormat": "cpu {{instance}}", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100", "legendFormat": "mem {{instance}}", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/nix\"} / node_filesystem_size_bytes{mountpoint=\"/nix\"}) * 100", "legendFormat": "/nix {{instance}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "title": "AI Tier Latency (probe, s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "probe_duration_seconds{tier=\"ai\"}", "legendFormat": "{{service}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "title": "Jev Decisions / Confidence",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "sum by (workflow) (rate(jev_decisions_total[5m]))", "legendFormat": "{{workflow}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "title": "Eval Metrics",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        { "expr": "{__name__=~\"jarvis_eval_(rag_precision|crash_recovery_rate|command_interception_rate|token_compression_ratio|jev_latency_ms|anchor_search_hit_rate)\"}", "format": "table", "instant": true, "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true }, "renameByName": { "__name__": "Metric", "Value": "Value" } } }
      ]
    },
    {
      "title": "Recent Errors (all hosts)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        { "expr": "{job=\"systemd-journal\"} |~ \"(?i)(error|fail|panic)\"", "datasource": { "type": "loki", "uid": "loki" } }
      ],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}

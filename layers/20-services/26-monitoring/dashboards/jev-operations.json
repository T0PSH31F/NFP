{
  "title": "Jev System-1 Operations & Observability",
  "uid": "jev-operations",
  "tags": ["jev", "ai", "system-1", "observability", "routing"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "10s",
  "panels": [
    {
      "title": "Jev Engine Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "jev_engine_up",
          "legendFormat": "Engine Daemon",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "ACTIVE", "color": "green" }
              }
            }
          ]
        }
      }
    },
    {
      "title": "Total Decisions Processed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "sum(jev_decisions_total)",
          "legendFormat": "Decisions",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      }
    },
    {
      "title": "Estimated Frontier LLM Cost Saved",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "jev_cost_saved_usd_total",
          "legendFormat": "USD Saved",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "currencyUSD",
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1.0 }
            ]
          }
        }
      }
    },
    {
      "title": "Mean Decision Confidence",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 13, "y": 0 },
      "targets": [
        {
          "expr": "avg(jev_decision_confidence_score)",
          "legendFormat": "Avg Confidence",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      }
    },
    {
      "title": "Average Evaluation Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "rate(jev_decision_duration_seconds_sum[5m]) / rate(jev_decision_duration_seconds_count[5m]) * 1000",
          "legendFormat": "Avg Latency",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "title": "Decision Throughput by Workflow",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (workflow) (rate(jev_decisions_total[5m]))",
          "legendFormat": "{{workflow}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          }
        }
      }
    },
    {
      "title": "Confidence Score Distribution by Workflow",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "jev_decision_confidence_score",
          "legendFormat": "{{workflow}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.88 }
            ]
          }
        }
      }
    },
    {
      "title": "Live Jev Fleet Journal Logs (Loki)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "{unit=~\"jev-.*|fs-organizer.*|email-triage.*|lead-triage.*|ad-miner.*\"}",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}

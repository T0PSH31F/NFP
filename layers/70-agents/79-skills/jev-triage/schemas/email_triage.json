{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmailTriageDecision",
  "description": "System-1 Jev decision schema for email categorization, action requirements, and agent routing.",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "description": "MIME headers and message body snippet of the target email."
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["enum", "boolean"]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["id", "type"]
      }
    }
  },
  "required": ["state", "questions"],
  "default_questions": [
    {
      "id": "category",
      "type": "enum",
      "options": [
        "invoice_financial",
        "security_auth",
        "personal",
        "newsletter",
        "automated_alert",
        "spam"
      ]
    },
    {
      "id": "action_required",
      "type": "boolean"
    },
    {
      "id": "target_agent",
      "type": "enum",
      "options": [
        "hermes_billing",
        "paperclip_ops",
        "archive_silent"
      ]
    }
  ]
}
